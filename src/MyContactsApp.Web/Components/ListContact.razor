@inject ContactService contactService
@inject AddressBookService addressBookService
@page "/uc1"

<h3>List of Contacts</h3>

<span class="badge bg-secondary fs-6">Total: @totalCount</span>

<div class="row g-2 my-3">
    <div class="col-md-3">
        <select class="form-select" @bind="searchType">
            <option value="City">City</option>
            <option value="State">State</option>
        </select>
    </div>

    <div class="col-md-6">
        <input class="form-control"
               placeholder="Enter city or state..."
               @bind="searchTerm"
               @bind:event="oninput" />
    </div>

    <div class="col-md-3">
        <button type="button" class="btn btn-primary"
                @onclick="SearchContacts">
            Search
        </button>

        @* <button type="button" class="btn btn-primary" @onclick="TestClick">
            Test Click
        </button>
        <p>@testMessage</p> *@
        <button type="button" class="btn btn-secondary"
                @onclick="ClearSearch">
            Clear
        </button>
    </div>
</div>

@if (searched)
{
    <p>Found @filteredList.Count contact(s):</p>
}

<div class="card">
    <ul class="list-group list-group-flush">
        @foreach (var contact in filteredList)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <small>@contact.ToString()</small>

                <div>
                    <a href="/contacts/edit/@contact.Id"
                       class="btn btn-primary btn-sm">Edit</a>

                    <form action="/Contacts/Delete/@contact.Id"
                          method="post" style="display:inline;">
                        <button type="submit"
                                class="btn btn-sm btn-outline-danger">
                            Delete
                        </button>
                    </form>
                </div>
            </li>
        }
    </ul>
</div>

@if (searched && filteredList.Count == 0)
{
    <p class="text-muted mt-3">No matching contacts found.</p>
}

@code {
    private List<Contact> allContacts = new();
    private List<Contact> filteredList = new();
    private int totalCount;

    private string searchType = "City";
    private string searchTerm = string.Empty;
    private bool searched;

    protected override async Task OnInitializedAsync()
    {
        allContacts = await contactService.GetAllContactsAsync();
        filteredList = allContacts;
        totalCount = await addressBookService.GetTotalContactCountAsync();
    }

    private async Task SearchContacts()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredList = allContacts;
            searched = false;
            return;
        }

        filteredList = searchType == "City"
            ? await contactService.SearchByCityAsync(searchTerm)
            : await contactService.SearchByStateAsync(searchTerm);

        searched = true;
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        filteredList = allContacts;
        searched = false;
    }

    private string testMessage = "Not clicked";

    private void TestClick()
    {
        testMessage = "Button event works";
    }
}