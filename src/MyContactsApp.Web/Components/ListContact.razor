@page "/uc1"
@inject ContactService contactService
@inject AddressBookService addressBookService

<h3>List of Contacts</h3>

<span class="badge bg-secondary fs-6">Total: @totalCount</span>

<!-- Search Bar -->
<div class="row g-2 my-3">
    <div class="col-md-3">
        <select class="form-select" @bind="searchType">
            <option value="City">City</option>
            <option value="State">State</option>
        </select>
    </div>

    <div class="col-md-6">
        <input class="form-control"
               placeholder="Enter city or state..."
               @bind="searchTerm"
               @bind:event="oninput" />
    </div>

    <div class="col-md-3">
        <button type="button" class="btn btn-primary"
                @onclick="SearchContacts">
            Search
        </button>
        <button type="button" class="btn btn-secondary"
                @onclick="ClearSearch">
            Clear
        </button>
    </div>
</div>

<!-- UC 11 & UC 12: Sort Controls -->
<div class="d-flex align-items-center gap-2 my-3 p-2 bg-light rounded border">
    <label class="fw-bold mb-0">Sort By:</label>
    <select class="form-select w-auto" @onchange="OnSortChanged">
        <option value="Default">Default</option>
        <option value="Name">Name (First + Last) [UC 11]</option>
        <option value="City">City [UC 12]</option>
        <option value="State">State [UC 12]</option>
        <option value="Zip">Zip [UC 12]</option>
    </select>
    @if (selectedSort != "Default")
    {
        <span class="text-muted small">Sorted by: @selectedSort</span>
    }
</div>

@if (searched)
{
    <p>Found @filteredList.Count contact(s):</p>
}

<!-- UC 11: Table Component for Rendering -->
@if (filteredList.Count == 0)
{
    <p class="text-muted mt-3">No matching contacts found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Zip</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in filteredList)
                {
                    <tr>
                        <td><strong>@contact.FirstName @contact.LastName</strong></td>
                        <td>@contact.Address</td>
                        <td>@contact.City</td>
                        <td>@contact.State</td>
                        <td>@contact.Zip</td>
                        <td>@contact.PhoneNumber</td>
                        <td>@contact.Email</td>
                        <td>
                            <a href="/contacts/edit/@contact.Id" class="btn btn-primary btn-sm">Edit</a>
                            <button class="btn btn-sm btn-outline-danger ms-1"
                                    @onclick="() => DeleteContact(contact.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Contact> allContacts = new();
    private List<Contact> filteredList = new();
    private int totalCount;

    private string searchType = "City";
    private string searchTerm = string.Empty;
    private bool searched;
    private string selectedSort = "Default";

    protected override async Task OnInitializedAsync()
    {
        await LoadContactsAsync();
    }

    private async Task LoadContactsAsync()
    {
        allContacts = await contactService.GetAllContactsAsync();
        filteredList = allContacts;
        totalCount = await addressBookService.GetTotalContactCountAsync();
    }

    private async Task SearchContacts()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredList = allContacts;
            searched = false;
            return;
        }

        filteredList = searchType == "City"
            ? await contactService.SearchByCityAsync(searchTerm)
            : await contactService.SearchByStateAsync(searchTerm);

        searched = true;
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        filteredList = allContacts;
        searched = false;
        selectedSort = "Default";
    }

    // Handles UC 11 & UC 12 Sorting
    private async Task OnSortChanged(ChangeEventArgs e)
    {
        selectedSort = e.Value?.ToString() ?? "Default";

        filteredList = selectedSort switch
        {
            "Name"  => await contactService.SortByNameAsync(),
            "City"  => await contactService.SortByCityAsync(),
            "State" => await contactService.SortByStateAsync(),
            "Zip"   => await contactService.SortByZipAsync(),
            _       => await contactService.GetAllContactsAsync()
        };
    }

    private async Task DeleteContact(int id)
    {
        await contactService.DeleteContactAsync(id);
        await LoadContactsAsync();
    }
}