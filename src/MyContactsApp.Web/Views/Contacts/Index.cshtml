@model List<Contact>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-4">
    <h4 class="display-4">Welcome to MyContactsApp</h4>
</div>

<div>
    Create a new contact:
    <a asp-controller="Contacts" asp-action="Add" class="btn btn-primary">Create</a>
</div>

<component type="typeof(MyContactsApp.Web.Components.ListContact)" render-mode="ServerPrerendered" /> 