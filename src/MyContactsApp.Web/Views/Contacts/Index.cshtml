@model List<Contact>

@{
    ViewData["Title"] = "Contacts";
}

<h2>Welcome to MyContactsApp</h2>

<a asp-controller="Contacts"
   asp-action="Add"
   class="btn btn-primary">Create Contact</a>

<form method="get" asp-controller="Contacts"
      asp-action="Index" class="my-3">
    <div class="row g-2">
        <div class="col-md-3">
            <input name="city" value="@ViewBag.City"
                   class="form-control" placeholder="Search city" />
        </div>

        <div class="col-md-3">
            <input name="state" value="@ViewBag.State"
                   class="form-control" placeholder="Search state" />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-controller="Contacts" asp-action="Index"
               class="btn btn-secondary">Clear</a>
        </div>
    </div>
</form>

@if (ViewBag.SearchPerformed == true)
{
    <p>Found @Model.Count contact(s):</p>
}

@if (Model.Count == 0)
{
    <p>No matching contacts found.</p>
}
else
{
    <ul class="list-group">
        @foreach (var contact in Model)
        {
            <li class="list-group-item">
                @contact.ToString()

                <a href="/contacts/edit/@contact.Id"
                   class="btn btn-primary btn-sm ms-2">Edit</a>

                <form action="/Contacts/Delete/@contact.Id"
                      method="post" style="display:inline">
                    <button type="submit"
                            class="btn btn-outline-danger btn-sm">
                        Delete
                    </button>
                </form>
            </li>
        }
    </ul>
}